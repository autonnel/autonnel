---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { checkAuth } from '@/lib/auth/middleware';
import { userHasFeature, FEATURES } from '@/lib/rbac';
import { FunnelAnalyticsTab, AnalystPanelLauncher, FunnelAdPerformancePanel } from '@/components/analytics';
import { getTenantPrisma } from '@/modules/platform/infra/prisma-tenant-extension';
import { loadFunnelViewUrl } from '@/lib/dashboard/funnels-data';
import { loadAdReconciliation } from '@/lib/dashboard/ads-reconciliation-data';
import { resolveFunnelAdWindow } from '@/lib/dashboard/analytics-helpers';
import { getSiteTimezone } from '@/lib/config/keys';
import { createLogger } from '@/lib/logger';

const logger = createLogger('funnel:analytics-ads-panel');

const auth = await checkAuth(Astro);

if (!auth.authenticated || !auth.user) {
  return Astro.redirect('/login');
}

const hasAccess = await userHasFeature(auth.user.id, FEATURES.ANALYTICS);
if (!hasAccess) {
  return Astro.redirect('/');
}

const { funnelId } = Astro.params;

const url = new URL(Astro.request.url);
const initialStartDate = url.searchParams.get('startDate') || '';
const initialEndDate = url.searchParams.get('endDate') || '';
const initialTimezone = url.searchParams.get('timezone') || (await getSiteTimezone().catch(() => '')) || '';
const prisma = getTenantPrisma();

const funnel = await prisma.funnel.findUnique({
  where: { id: funnelId },
  select: {
    id: true,
    name: true,
    description: true,
  },
});

if (!funnel) {
  return new Response('Funnel not found', { status: 404 });
}

const viewUrl = await loadFunnelViewUrl(funnelId!);

const adWindow = resolveFunnelAdWindow({
  startDate: initialStartDate,
  endDate: initialEndDate,
  timezone: initialTimezone,
});

const adVm = await loadAdReconciliation({
  start: adWindow.start,
  end: adWindow.end,
  startDateStr: adWindow.startDateStr,
  endDateStr: adWindow.endDateStr,
  funnelId: funnelId!,
}).catch((err) => {
  logger.error('ad reconciliation failed to load for funnel analytics tab', { error: err, funnelId });
  return null;
});
// loadAdReconciliation now scopes unassigned creatives to this funnel's own candidateFunnelIds, so
// a currency group can no longer exist with zero rows AND zero scoped-unassigned creatives. It CAN
// still exist with zero rows and a nonzero unattributedCreatives count -- a creative genuinely
// candidates for this funnel in a currency where it has no confirmed platform spend yet, which is
// real data, not a leak. This panel only shows platform-vs-onsite rows (unattributed-creative
// detail is the global page's job, see the note below), so it has nothing to render for such a
// group and must still filter it out here.
const adGroupsWithData = adVm?.currencyGroups.filter((g) => g.rows.length > 0) ?? [];

const tabs = [
  { id: 'overview', label: 'Overview', href: `/funnel/${funnelId}` },
  { id: 'pages', label: 'Pages', href: `/funnel/${funnelId}/pages` },
  { id: 'analytics', label: 'Analytics', href: `/funnel/${funnelId}/analytics` },
  { id: 'marketing', label: 'Marketing', href: `/funnel/${funnelId}/marketing` },
  { id: 'experiment', label: 'Experiment', href: `/funnel/${funnelId}/experiment` },
  { id: 'custom-code', label: 'Custom Code', href: `/funnel/${funnelId}/custom-code` },
  { id: 'settings', label: 'Settings', href: `/funnel/${funnelId}/settings` },
];
const activeTab = 'analytics';
---

<DashboardLayout
  title={funnel.name}
  activeNav="funnels.funnels"
  breadcrumbs={[
    { label: 'Autonnel', href: '/' },
    { label: 'Funnels', href: '/funnels' },
    { label: funnel.name, href: `/funnel/${funnelId}` },
    { label: 'Analytics' },
  ]}
>
  <div slot="header-actions" class="flex items-center gap-2">
    {viewUrl && (
      <a
        href={viewUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center font-medium rounded-[7px] h-8 px-3 text-[13px] gap-2 bg-ds-card border border-ds-line text-ds-ink hover:bg-[#F9FAFB] no-underline"
      >
        View
      </a>
    )}
    <AnalystPanelLauncher
      client:only="react"
      funnelId={funnel.id}
      funnelName={funnel.name}
    />
  </div>

  <div class="-mt-2 mb-5 border-b border-ds-line">
    <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Funnel sections">
      {tabs.map((t) => {
        const active = t.id === activeTab;
        const cls = active
          ? 'inline-flex items-center px-3 py-2.5 text-[13px] font-medium text-ds-ink border-b-2 border-ds-ink no-underline'
          : 'inline-flex items-center px-3 py-2.5 text-[13px] font-medium text-ds-muted hover:text-ds-ink border-b-2 border-transparent no-underline';
        return (
          <a href={t.href} class={cls}>
            {t.label}
          </a>
        );
      })}
    </nav>
  </div>

  <FunnelAnalyticsTab
    client:load
    funnelId={funnel.id}
    funnelName={funnel.name}
    initialStartDate={initialStartDate}
    initialEndDate={initialEndDate}
    initialTimezone={initialTimezone}
  />

  {adGroupsWithData.length > 0 && (
    <div class="mt-6 flex flex-col gap-4">
      {adGroupsWithData.map((group) => (
        <FunnelAdPerformancePanel
          client:load
          currency={group.currency}
          rows={group.rows}
          unattributedHref="/analytics/ads"
        />
      ))}
    </div>
  )}
</DashboardLayout>
