---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { checkAuth } from '@/lib/auth/middleware';
import { userHasFeature, FEATURES } from '@/lib/rbac';
import { loadFunnelOptions, loadTrafficSources } from '@/lib/dashboard/analytics-data';
import { resolveAnalyticsWindow, trafficSourceLabel } from '@/lib/dashboard/analytics-helpers';
import { loadInterestRows, loadPrimaryStorefrontHost } from '@/lib/dashboard/interest-data';
import {
  QUADRANTS,
  QUADRANT_LABEL,
  QUADRANT_HINT,
  quadrantShares,
  formatDuration,
  DEEP_SCREENS,
  DEEP_PCT,
  LONG_MS,
  type Quadrant,
} from '@/lib/stats/engagement';
import { TIMEZONE_OPTIONS } from '@/lib/constants/timezone';
import { getSiteTimezone } from '@/lib/config/keys';
import { cn } from '@/lib/utils';
import { createLogger } from '@/lib/logger';
import { dsSelectClass, dsFieldClass } from '@/components/primitives/field-styles';
import AnalyticsTabs from '@/components/analytics/AnalyticsTabs.astro';
import InterestBands from '@/components/analytics/InterestBands.astro';

// Fixed categorical order (worst -> best): BOUNCED reads as the bad outcome, ENGAGED as the
// good one, so a reader can scan the bar without consulting the legend on every row. Validated
// with the dataviz skill against the ds-card surface (light #FFFFFF, dark #1a1a19): CVD separation
// and the normal-vision floor both pass on every adjacent pair in both modes; the light-mode
// magenta fill sits below the 3:1 contrast floor for its own background, a legal WARN because
// the row already ships the 2px surface gaps between segments, the legend, and per-segment
// tooltips as secondary encoding. Label colour is picked per fill (white or near-black,
// whichever clears contrast against that specific hex) rather than fixed, since a single
// white label would have forced every fill dark and ruled out the warm end of the range.
const QUADRANT_COLOR: Record<Quadrant, { fill: string; label: string }> = {
  BOUNCED: { fill: '#e34948', label: '#0b0b0b' },
  SKIMMED: { fill: '#4a3aa7', label: '#FFFFFF' },
  STALLED: { fill: '#e87ba4', label: '#0b0b0b' },
  ENGAGED: { fill: '#008300', label: '#FFFFFF' },
};

const logger = createLogger('analytics:interest-page');

const auth = await checkAuth(Astro);
if (!auth.authenticated || !auth.user) return Astro.redirect('/login');
if (!(await userHasFeature(auth.user.id, FEATURES.ANALYTICS))) return Astro.redirect('/');

const url = new URL(Astro.request.url);
const funnelId = url.searchParams.get('funnel') || '';
const sourceFilter = (url.searchParams.get('source') || '').trim().toUpperCase();
const pageTypeFilter = (url.searchParams.get('pageType') || '').trim().toUpperCase();
// Default on: the question is where the people who did NOT buy lost interest,
// and a buyer necessarily reached the payment form.
const excludeBuyers = url.searchParams.get('buyers') !== 'include';

const siteTimezone = await getSiteTimezone().catch(() => undefined);
const timeWindow = resolveAnalyticsWindow({
  range: url.searchParams.get('range'),
  start: url.searchParams.get('start'),
  end: url.searchParams.get('end'),
  tz: url.searchParams.get('tz') || siteTimezone,
});

const [funnelOptions, trafficSources, allRows, storefrontHost] = await Promise.all([
  loadFunnelOptions().catch(() => []),
  loadTrafficSources({ funnelId: funnelId || null, window: timeWindow }).catch(() => []),
  // Returns null, not [], on failure: an empty array here would render the
  // "nothing was measured in this range" copy, which asserts a cause that a
  // query error makes false.
  loadInterestRows({
    funnelId: funnelId || null,
    source: sourceFilter || null,
    excludeBuyers,
    window: timeWindow,
  }).catch((err) => {
    logger.error('interest rows failed to load', { error: err });
    return null;
  }),
  loadPrimaryStorefrontHost().catch(() => null),
]);

const loadFailed = allRows === null;
const loadedRows = allRows ?? [];

// Options come from the unfiltered rows so that choosing a type does not shrink
// the list it was chosen from.
const pageTypeOptions = [...new Set(loadedRows.map((r) => (r.pageType || 'OTHER').toUpperCase()))].sort();
const rows = pageTypeFilter
  ? loadedRows.filter((r) => (r.pageType || 'OTHER').toUpperCase() === pageTypeFilter)
  : loadedRows;
const filteredToNothing = !loadFailed && loadedRows.length > 0 && rows.length === 0;

function bandUrl(slug: string | null, pct: number): string | null {
  if (!storefrontHost || !slug) return null;
  return `https://${storefrontHost}/${slug.replace(/^\/+/, '')}?_ad=${pct}`;
}

const sourceOptions = trafficSources.map((t) => ({ value: t.source, label: t.label }));
if (sourceFilter && !sourceOptions.some((o) => o.value === sourceFilter)) {
  sourceOptions.unshift({ value: sourceFilter, label: trafficSourceLabel(sourceFilter) });
}

const presetRange = timeWindow.range === 'custom' ? '' : timeWindow.range;
const customStart = timeWindow.range === 'custom' ? timeWindow.startDateStr : '';
const customEnd = timeWindow.range === 'custom' ? timeWindow.endDateStr : '';

const BUYERS_HINT =
  'Drops visitors who bought in this range, so the groups describe people who left without buying. UV here is lower than on Overview.';
const FOOTNOTE = `Deep means getting past the first ${DEEP_SCREENS} screens, measured against each page's own height wherever the visitor's beacon reported what share of the page one screen covers, and against a fixed ${DEEP_PCT}% of the page for the visits that did not report it. Scaling by screens is what makes the same colour mean the same thing on a one-screen checkout and a fifty-screen landing page; long means staying ${Math.round(LONG_MS / 1000)} seconds or more. Time counts foreground only, wherever the beacon reports it: it starts when the tracker loads (not at navigation) and stops while the tab is backgrounded. UV here does not match Overview: buyers are excluded by default, a visitor is counted only once their leave beacon arrived, and this table holds nothing from before it was deployed.`;
---

<DashboardLayout title="Analytics - Interest" activeNav="analytics">
  <div class="grid grid-cols-12 gap-5">
    <AnalyticsTabs active="interest" query={url.search} />

    <div class="col-span-12 bg-ds-card border border-ds-line rounded-[10px] shadow-[0_1px_2px_rgba(17,24,39,.04)] px-6 py-4">
      <form method="get" action="/analytics/interest" class="flex items-end justify-between gap-4 flex-wrap">
        <input type="hidden" name="range" id="if-range" value={presetRange} />
        <div class="flex items-end gap-3 flex-wrap">
          <div class="flex flex-col gap-1">
            <label class="text-[11.5px] uppercase tracking-[0.02em] text-ds-muted">Funnel</label>
            <select name="funnel" onchange="this.form.submit()" class={cn(dsSelectClass, "h-8 min-w-[160px]")}>
              <option value="">All funnels</option>
              {funnelOptions.map((f) => (
                <option value={f.id} selected={funnelId === f.id}>{f.name}</option>
              ))}
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[11.5px] uppercase tracking-[0.02em] text-ds-muted">Source</label>
            <select name="source" onchange="this.form.submit()" class={cn(dsSelectClass, "h-8 min-w-[140px]")}>
              <option value="">All sources</option>
              {sourceOptions.map((o) => (
                <option value={o.value} selected={sourceFilter === o.value}>{o.label}</option>
              ))}
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[11.5px] uppercase tracking-[0.02em] text-ds-muted">Page type</label>
            <select name="pageType" onchange="this.form.submit()" class={cn(dsSelectClass, "h-8 min-w-[130px]")}>
              <option value="">All types</option>
              {pageTypeOptions.map((t) => (
                <option value={t} selected={pageTypeFilter === t}>{t}</option>
              ))}
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[11.5px] uppercase tracking-[0.02em] text-ds-muted">Quick range</label>
            <div class="inline-flex rounded-[7px] border border-ds-line overflow-hidden h-8">
              {(['24h', '7d', '30d'] as const).map((r, i) => (
                <button
                  type="button"
                  data-range={r}
                  class={cn(
                    "if-preset px-3 text-[12.5px] font-medium",
                    i > 0 && "border-l border-ds-line",
                    timeWindow.range === r ? "bg-ds-ink text-ds-card" : "bg-ds-card text-ds-slate hover:bg-[#F9FAFB]",
                  )}
                >{r}</button>
              ))}
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[11.5px] uppercase tracking-[0.02em] text-ds-muted">From</label>
            <input type="date" name="start" id="if-start" value={customStart} class={cn(dsFieldClass, "h-8 w-[140px]")} />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[11.5px] uppercase tracking-[0.02em] text-ds-muted">To</label>
            <input type="date" name="end" id="if-end" value={customEnd} class={cn(dsFieldClass, "h-8 w-[140px]")} />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[11.5px] uppercase tracking-[0.02em] text-ds-muted">Timezone</label>
            <select name="tz" onchange="this.form.submit()" class={cn(dsSelectClass, "h-8 min-w-[110px]")}>
              {TIMEZONE_OPTIONS.map((o) => (
                <option value={o.value} selected={timeWindow.tz === o.value}>{o.label}</option>
              ))}
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[11.5px] uppercase tracking-[0.02em] text-ds-muted opacity-0 select-none">Buyers</label>
            <label class="flex items-center gap-1.5 h-8 text-[12.5px] text-ds-slate" title={BUYERS_HINT}>
              <input type="checkbox" name="buyers" value="include" checked={!excludeBuyers} class="rounded border-ds-line" />
              Include buyers
            </label>
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center font-medium rounded-[7px] h-8 px-4 text-[13px] bg-ds-ink border border-ds-ink text-ds-card hover:bg-[#1F2937]"
          >
            Apply
          </button>
        </div>
        <div class="text-right">
          <div class="text-[12.5px] text-ds-muted">Showing</div>
          <div class="text-[14px] font-semibold text-ds-ink mt-0.5">{timeWindow.label}</div>
        </div>
      </form>
    </div>

    <div class="col-span-12 bg-ds-card border border-ds-line rounded-[10px] shadow-[0_1px_2px_rgba(17,24,39,.04)]">
      <div class="px-6 pt-5 pb-4">
        <div class="text-[14px] font-semibold text-ds-ink">Interest</div>
        <div class="text-[12.5px] text-ds-muted mt-0.5">Per-page attention and where interest drops off · {timeWindow.label}</div>
        <div class="flex items-center gap-4 flex-wrap mt-3">
          {QUADRANTS.map((q) => (
            <div class="flex items-center gap-1.5 text-[12px] text-ds-slate" title={QUADRANT_HINT[q]}>
              <span class="inline-block w-2.5 h-2.5 rounded-[2px]" style={`background-color: ${QUADRANT_COLOR[q].fill};`}></span>
              {QUADRANT_LABEL[q]}
            </div>
          ))}
        </div>
      </div>

      {loadFailed ? (
        <div class="px-6 py-12 text-center text-[13px] text-ds-muted">
          Could not load attention data. This is a query failure, not an empty range: nothing here is a statement about your traffic. Try again, and check the server logs if it persists.
        </div>
      ) : filteredToNothing ? (
        <div class="px-6 py-12 text-center text-[13px] text-ds-muted">
          No page of this type was measured in this range. Other page types have data; clear the page type filter to see them.
        </div>
      ) : rows.length === 0 ? (
        <div class="px-6 py-12 text-center text-[13px] text-ds-muted">
          Nothing measured in this range. This table starts collecting when the feature ships, so any range before that is empty by definition.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead class="bg-ds-surface2 border-b border-ds-line">
              <tr>
                <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-left">Page</th>
                <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-right">UV</th>
                <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-left">Attention</th>
                <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-right">Median time</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => {
                const shares = quadrantShares(row.counts, row.uv);
                const dwellTitle = row.activeCoverage < 1
                  ? `${Math.round(row.activeCoverage * 100)}% of these visits reported foreground-only time; the rest mix in backgrounded page time.`
                  : undefined;
                const depthNote = row.screensCoverage < 1
                  ? `${Math.round(row.screensCoverage * 100)}% of these visits reported their screen share, so deep is measured against this page's own height; the rest fall back to a fixed ${DEEP_PCT}% of the page.`
                  : undefined;
                return (
                  <Fragment>
                    <tr class="hover:bg-ds-surface2 transition-colors cursor-pointer" data-interest-row={row.pageId}>
                      <td class="px-4 py-3 text-[13.5px] text-ds-ink border-b border-[#F3F4F6]">
                        <div class="font-medium">{row.pageName || row.pageId}</div>
                        {row.funnelName ? (
                          <div class="text-[11px] text-ds-faint truncate">{row.funnelName}</div>
                        ) : row.funnelCount > 1 ? (
                          <div class="text-[11px] text-ds-faint truncate" title="This page is referenced by more than one funnel, and the numbers on this row are summed across all of them.">Shared across funnels</div>
                        ) : null}
                      </td>
                      <td class="px-4 py-3 text-[13.5px] text-ds-ink border-b border-[#F3F4F6] text-right font-ds-mono tabular">{row.uv}</td>
                      <td class="px-4 py-3 border-b border-[#F3F4F6]" title={depthNote}>
                        {shares && (
                          <div class="flex w-full h-5 rounded-[4px] overflow-hidden bg-ds-surface2 gap-[2px]">
                            {QUADRANTS.map((q) => {
                              const count = row.counts[q];
                              const pct = shares[q];
                              // Written as !(pct > 0) rather than pct <= 0: the Astro compiler misparses a
                              // literal "<=" here as a stray tag start inside this nested map's JSX return.
                              if (!(pct > 0)) return null;
                              const titleBase = `${QUADRANT_LABEL[q]}: ${count} of ${row.uv} visitors (${pct.toFixed(1)}%). ${QUADRANT_HINT[q]}`;
                              const title = [
                                titleBase,
                                row.screensTall !== null ? `This page is about ${Math.round(row.screensTall)} screens tall.` : null,
                                depthNote,
                              ].filter(Boolean).join(' ');
                              return (
                                <div
                                  class="h-full flex items-center justify-center overflow-hidden"
                                  style={`width: ${pct}%; background-color: ${QUADRANT_COLOR[q].fill};`}
                                  title={title}
                                >
                                  {pct >= 9 && (
                                    <span class="text-[10.5px] font-medium leading-none" style={`color: ${QUADRANT_COLOR[q].label};`}>{Math.round(pct)}%</span>
                                  )}
                                </div>
                              );
                            })}
                          </div>
                        )}
                      </td>
                      <td
                        class="px-4 py-3 text-[13.5px] text-ds-ink border-b border-[#F3F4F6] text-right font-ds-mono tabular"
                        style={`opacity: ${0.45 + 0.55 * row.activeCoverage};`}
                        title={dwellTitle}
                      >
                        {formatDuration(row.medianDwellMs)}
                      </td>
                    </tr>
                    <InterestBands row={row} bandUrl={bandUrl} />
                  </Fragment>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
      <div class="px-6 py-4 border-t border-ds-line text-[11.5px] text-ds-faint leading-relaxed">{FOOTNOTE}</div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.if-preset').forEach((el) => {
      el.addEventListener('click', () => {
        const btn = el as HTMLElement;
        const form = btn.closest('form') as HTMLFormElement | null;
        if (!form) return;
        const start = form.querySelector('#if-start') as HTMLInputElement | null;
        const end = form.querySelector('#if-end') as HTMLInputElement | null;
        const range = form.querySelector('#if-range') as HTMLInputElement | null;
        if (start) start.value = '';
        if (end) end.value = '';
        if (range) range.value = btn.dataset.range || '';
        form.submit();
      });
    });
  </script>

  <script is:inline>
    document.querySelectorAll('[data-interest-row]').forEach(function (row) {
      row.addEventListener('click', function () {
        var detail = document.getElementById('bands-' + row.getAttribute('data-interest-row'));
        if (detail) detail.hidden = !detail.hidden;
      });
    });
  </script>
</DashboardLayout>
